{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Modify Armor Equipment",
    "color": "#ff9175"
  },
  "external_title": "Armor",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Modify an existing NPCs Armor. Make sure to select the correct NPC(s).",
      "width": 250
    }
  ],
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "type",
      "label": "Type",
      "options": [
        {
          "id": "@n",
          "display": "Nearest NPC",
          "initial": true
        },
        {
          "id": "@e",
          "display": "All NPC's",
          "initial": false
        }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "head_item",
      "label": "Head Item",
      "label_visible": true,
      "initial": "minecraft:air"
    },
    {
      "type": "minecraft:boolean",
      "key": "head_ench",
      "label": "Show enchantment glint",
      "initial": false
    },
    {
      "type": "minecraft:text",
      "key": "chest_item",
      "label": "Chest Item",
      "label_visible": true,
      "initial": "minecraft:air"
    },
    {
      "type": "minecraft:boolean",
      "key": "chest_ench",
      "label": "Show enchantment glint",
      "initial": false
    },
    {
      "type": "minecraft:text",
      "key": "leg_item",
      "label": "Leg Item",
      "label_visible": true,
      "initial": "minecraft:air"
    },
    {
      "type": "minecraft:boolean",
      "key": "leg_ench",
      "label": "Show enchantment glint",
      "initial": false
    },
    {
      "type": "minecraft:text",
      "key": "feet_item",
      "label": "Feet Item",
      "label_visible": true,
      "initial": "minecraft:air"
    },
    {
      "type": "minecraft:boolean",
      "key": "feet_ench",
      "label": "Show enchantment glint",
      "initial": false
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": "Modify Armor",
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "/execute as $(type)[type=mannequin] run data merge entity @s {equipment:{feet:{id:\"$(feet_item)\",count:1,components:{\"minecraft:enchantment_glint_override\":$(feet_ench)}},legs:{id:\"$(leg_item)\",count:1,components:{\"minecraft:enchantment_glint_override\":$(leg_ench)}},chest:{id:\"$(chest_item)\",count:1,components:{\"minecraft:enchantment_glint_override\":$(chest_ench)}},head:{id:\"$(head_item)\",count:1,components:{\"minecraft:enchantment_glint_override\":$(head_ench)}}}}"
    }
  },
  "no": {
    "label": "Back",
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "vanillanpc:options"
    }
  }
}